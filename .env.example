# Webhook du salon forum Discord (requis)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000/xxx

# Override optionnel par service (clé = key de services.json, en majuscules)
# DISCORD_WEBHOOK_CLAUDE=https://discord.com/api/webhooks/111/yyy

POLL_INTERVAL_SECONDS=60
STATE_PATH=/app/data/state.json
SERVICES_PATH=./services.json

# Dead man's switch (Healthchecks.io) — optionnel
# HEALTHCHECK_URL=https://hc-ping.com/xxxxxxxx

DRY_RUN=false
LOG_LEVEL=info
